{
  "name": "iobroker.chromecast",
  "version": "4.2.0",
  "description": "ioBroker chromecast Adapter",
  "author": "Vegetto <iobroker@angelnu.com>",
  "contributors": [
    "Vegetto <iobroker@angelnu.com>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.chromecast",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "chromecast",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.chromecast.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "castv2-client": "^1.2.0",
    "icy": "^2.1.0",
    "mime-types": "^2.1.35",
    "multicast-dns": "^7.2.5",
    "node-arp": "^1.0.6",
    "playlist-parser": "^0.0.12",
    "youtube-remote": "^1.1.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@iobroker/web-components": "^0.8.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.chromecast/issues"
  },
  "readmeFilename": "README.md",
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:devices": "node tasks.mts --devices",
    "build:wc": "node tasks.mts --wc && iob-web-components sync-io-package",
    "build:front": "node tasks.mts && iob-web-components sync-io-package",
    "check:devices": "cd src-devices && npm run check-ts",
    "check:wc": "cd src-webcomponents && npm run check-ts",
    "lint": "eslint -c eslint.config.mjs",
    "lint:devices": "cd src-devices && npm run lint",
    "lint:wc": "cd src-webcomponents && npm run lint",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  }
}
