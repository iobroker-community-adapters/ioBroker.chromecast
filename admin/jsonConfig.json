{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_mainTab": {
            "type": "panel",
            "label": "Main settings",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "home.png",
                    "style": {
                        "width": "100%",
                        "maxWidth": 200
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "web": {
                    "type": "instance",
                    "adapter": "web",
                    "label": "Web instance",
                    "help": "Used to play local files: they are copied into the file storage of the adapter and served by this web instance",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 5
                },
                "webServer": {
                    "type": "selectSendTo",
                    "command": "getWebServerIps",
                    "jsonData": "{\"web\": \"${data.web}\"}",
                    "alsoDependsOn": ["web"],
                    "noTranslation": true,
                    "label": "Web server IP",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 5
                },
                "_webCheck": {
                    "type": "textSendTo",
                    "command": "checkWebInstance",
                    "jsonData": "{\"web\": \"${data.web}\"}",
                    "alsoDependsOn": ["web"],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 10
                }
            }
        },
        "_devicesTab": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "_devicesInfo": {
                    "type": "staticText",
                    "text": "The adapter finds Google Cast devices in the same subnet via mDNS. Devices in other subnets can be added here by hand.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12
                },
                "_devicesIdInfo": {
                    "type": "staticText",
                    "text": "Found devices get their MAC address as ID, devices added by hand the name entered here.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12
                },
                "manualDevices": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "35%",
                            "filter": true,
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "title": "IP address",
                            "width": "25%",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "port",
                            "title": "Port",
                            "min": 1,
                            "max": 65535,
                            "width": "15%",
                            "default": 8009
                        },
                        {
                            "type": "select",
                            "attr": "type",
                            "title": "Type",
                            "noTranslation": true,
                            "options": [
                                { "label": "Chromecast", "value": "Chromecast" },
                                { "label": "Chromecast Audio", "value": "Chromecast Audio" },
                                { "label": "Google Cast Group", "value": "Google Cast Group" }
                            ],
                            "width": "25%",
                            "default": "Chromecast"
                        }
                    ]
                }
            }
        }
    }
}
